# Read-only endpoints only. Never put key material in this file.
# REQUIRED for a non-default RPC: a public Solana JSON-RPC endpoint or a local
# environment-provided endpoint. The application uses public Mainnet RPC by default.
SOLANA_RPC_URL=

# OPTIONAL provider endpoints (public defaults are used when blank).
HELIUS_RPC_URL=
GMGN_BASE_URL=
DEXSCREENER_BASE_URL=
JUPITER_TOKENS_URL=

# PHASE_2A_LIVE_ONLY: optional provider credential, supplied only in the local
# environment when explicitly approved. Never commit a populated value.
JUPITER_API_KEY=

# PHASE_2A_LIVE_ONLY: quote-only Jupiter V2 endpoint and compatibility switch.
JUPITER_QUOTE_URL=
JUPITER_ALLOW_LEGACY_FALLBACK=false
JUPITER_LEGACY_QUOTE_URL=
